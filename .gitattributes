# Cohort TSVs may end with intentional empty optional fields represented by tabs.
# eol=lf is required, not cosmetic: cohorts/*.lock.json pins a SHA-256 of the
# matching .tsv (see validate_cohort.py's --verify-lock). Without it, a clone
# on a system with core.autocrlf=true -- Git for Windows's own recommended
# default -- rewrites LF to CRLF on checkout, the checksum no longer matches,
# and `plasbench test` fails immediately with "sample-sheet checksum differs
# from verification lock" on a completely unmodified fresh clone.
*.tsv text eol=lf -whitespace
*.json text eol=lf

# Pipeline entry points must remain executable in Linux, WSL, Docker, and CI.
*.sh text eol=lf
