data/
# ...but not the package's own data folder: it holds the plasbench ui page (plasbench/data/ui.html).
!plasbench/data/
results/
# study folders (plasbench run --study; the window's Workspace page): user data, never committed
studies/
results_demo/
results_demo_metagenomics/
logs/
tmp/
# SRA Toolkit `fasterq-dump` working directories are transient local caches.
/fasterq.tmp.*/
*.sra
*.fastq
*.fastq.gz
__pycache__/
*.pyc
.ncbi.env
config/local.env
build/
*.egg-info/
!config/accessions.tsv
# Third-party reference figures kept locally for design (docs/images/reference/README.md says what each is for); never committed or shipped.
docs/images/reference/*.jpg
docs/images/reference/*.jpeg
docs/images/reference/*.png
!docs/images/reference/README.md

# Release archives are build output, produced by `make dist` and attached to
# GitHub Releases; they are not committed.
dist/

# Local assistant/session state; not part of the project.
.claude/

# Sample-level data stays out of git. Reads, assemblies, predictions and alignments can carry
# sample identity or patient-linked metadata, so the defaults below keep them untracked even if a
# laboratory runs outside the default data/ and results/ folders (or puts a git repository around
# its own study folder). Fixtures that ship with PlasBench are re-included further down.
meta_project/
predictions_meta/
assembly/
metadata/
*.fasta
*.fa
*.fna
*.fasta.gz
*.fa.gz
*.fna.gz
*.fq
*.fq.gz
*.bam
*.cram
*.sam
*.paf
*.vcf
*.vcf.gz
# Study metadata sheets a laboratory fills in (sample names, origin, dates).
meta_samples.tsv
accessions.local.tsv

# Shipped, synthetic or public fixtures (tracked on purpose).
!results_audit/
!results_audit/**
!galaxy/test-data/
!galaxy/test-data/**
!test/
!test/**
!demo/
!demo/**
!cohorts/
!cohorts/**
!docs/
!docs/**
!assets/
!assets/**
