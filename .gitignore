data/
# ...but not the package's own data folder: it holds the plasbench ui page (plasbench/data/ui.html).
!plasbench/data/
results/
results_demo/
results_demo_metagenomics/
logs/
tmp/
# SRA Toolkit `fasterq-dump` working directories are transient local caches.
/fasterq.tmp.*/
*.sra
*.fastq
*.fastq.gz
__pycache__/
*.pyc
.ncbi.env
config/local.env
build/
*.egg-info/
!config/accessions.tsv
# Third-party reference figures kept locally for design (docs/images/reference/README.md says what each is for); never committed or shipped.
docs/images/reference/*.jpg
docs/images/reference/*.jpeg
docs/images/reference/*.png
!docs/images/reference/README.md

# Release archives are build output, produced by `make dist` and attached to
# GitHub Releases; they are not committed.
dist/

# Local assistant/session state; not part of the project.
.claude/
